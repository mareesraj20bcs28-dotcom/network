#include <stdlib.h>

int minReorder(int n, int** connections, int connectionsSize,
               int* connectionsColSize)
{
    // Find degree of each city
    int* degree = calloc(n, sizeof(int));

    for (int i = 0; i < connectionsSize; i++)
    {
        int a = connections[i][0];
        int b = connections[i][1];

        degree[a]++;
        degree[b]++;
    }

    // Create graph
    int** graph = malloc(n * sizeof(int*));

    for (int i = 0; i < n; i++)
    {
        // For every neighbor, store:
        // neighbor + direction
        graph[i] = malloc(degree[i] * 2 * sizeof(int));

        degree[i] = 0;
    }

    // Build graph
    for (int i = 0; i < connectionsSize; i++)
    {
        int a = connections[i][0];
        int b = connections[i][1];

        // Original road: a -> b
        graph[a][degree[a]++] = b;
        graph[a][degree[a]++] = 1;

        // From b to a is opposite to original direction
        graph[b][degree[b]++] = a;
        graph[b][degree[b]++] = 0;
    }

    // BFS
    int* visited = calloc(n, sizeof(int));
    int* queue = malloc(n * sizeof(int));

    int front = 0;
    int rear = 0;
    int answer = 0;

    // Start from capital city 0
    queue[rear++] = 0;
    visited[0] = 1;

    while (front < rear)
    {
        int city = queue[front++];

        // Check all neighboring cities
        for (int i = 0; i < degree[city]; i += 2)
        {
            int next = graph[city][i];
            int cost = graph[city][i + 1];

            if (visited[next])
                continue;

            visited[next] = 1;

            // If cost = 1, road must be reversed
            answer += cost;

            queue[rear++] = next;
        }
    }

    // Free memory
    for (int i = 0; i < n; i++)
    {
        free(graph[i]);
    }

    free(graph);
    free(degree);
    free(visited);
    free(queue);

    return answer;
}
